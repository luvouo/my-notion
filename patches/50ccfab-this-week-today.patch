+      async function toggleArchivedItem(dateStr, id, button){
+        const items = archive[dateStr] || [];
+        const index = items.findIndex(it => String(it.id) === String(id));
+        if(index === -1) return;
+
+        const toggleKey = `${dateStr}::${id}`;
+        if(pendingArchiveToggles.has(toggleKey)) return;
+        pendingArchiveToggles.add(toggleKey);
+
+        const previousDone = Boolean(items[index].done);
+        const nextDone = !previousDone;
+        archive[dateStr] = items.map((it, i) => i === index ? ({ ...it, done: nextDone }) : it);
